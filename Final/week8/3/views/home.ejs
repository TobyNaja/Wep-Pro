<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #121212;
            color: #ffffff;
            padding: 40px 20px;
        }

        h1 {
            text-align: center;
            margin-bottom: 40px;
            font-size: 2.5rem;
            color: #fd8ce7;
        }
        .layout {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 25px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .card {
            background-color: #181818;
            padding: 20px;
            border-radius: 12px;
            cursor: pointer;
            height: 100%;
        }

        .card:hover {
            background-color: #684566;
        }

        .card img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 15px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5);
        }

        .card h2 {
            font-size: 1.1rem;
            margin-bottom: 10px;
            text-overflow: ellipsis;
        }

        .card p {
            font-size: 0.9rem;
            color: #b3b3b3;
            margin-bottom: 4px;
        }

        .card p span {
            color: #ffffff;
            font-weight: 500;
        }

        .card p:last-child {
            font-style: italic;
            color: #fd8ce7;
        }
    </style>
</head>

<body>
    <h1>The most popular albums</h1>
    <div class="layout">
        <% data.forEach(function(item) { %>
            <div class="card">
                <img src="<%= item.album_cover %>" alt="Cover">
                <h2>
                    <%= item.song %>
                </h2>
                <p>Album: <span>
                        <%= item.album %>
                    </span></p>
                <p>Artist: <span>
                        <%= item.artist %>
                    </span></p>
                <p>Genre: <span>
                        <%= item.genre %>
                    </span></p>
            </div>
            <% }); %>
    </div>
</body>

</html>