<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f9;
        }

        table {
            width: 90%;
            margin: 30px auto;
            border-collapse: collapse;
            background-color: #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }

        thead {
            background-color: #4CAF50;
            color: white;
        }

        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            font-size: 16px;
            font-weight: 600;
        }

        td {
            font-size: 14px;
        }

        tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        tr:hover {
            background-color: #ddd;
        }

        table, th, td {
            border-radius: 8px;
        }

        th {
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;
        }

        tr:last-child td {
            border-bottom-left-radius: 8px;
            border-bottom-right-radius: 8px;
        }

    </style>
</head>
<body>
    <table>
        <thead>
            <tr>
                <th>username</th>
                <th>password </th>
                <th>email </th>
                <th>firstname </th>
                <th>lastname </th>
                <th>age </th>
                <th>address </th>
                <th>phone</th>
            </tr>
        </thead>
        <tbody>
            <% data.forEach((item) => { %>
            <tr>
                <td><%= item.username %></td>
                <td><%= item.password %></td>
                <td><%= item.email %></td>
                <td><%= item.firstname %></td>
                <td><%= item.lastname %></td>
                <td><%= item.age %></td>
                <td><%= item.address %></td>
                <td><%= item.phone %></td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>
